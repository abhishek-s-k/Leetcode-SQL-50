SELECT
    product_id,
    year AS first_year,
    quantity,
    price
FROM
    Sales
WHERE
    (product_id,year) IN 
    (SELECT product_id, MIN(year) FROM Sales GROUP BY product_id)

-------------------------------------------------------------------------------

WITH cte AS(
    SELECT
        *,
        RANK() OVER(PARTITION BY product_id ORDER BY year) AS year_number
    FROM
        Sales
)

SELECT
    product_id,
    year as first_year,
    quantity,
    price
FROM
    cte
WHERE
    year_number=1