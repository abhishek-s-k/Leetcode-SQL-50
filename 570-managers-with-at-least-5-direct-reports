SELECT
    e2.name
FROM
    Employee e1
    JOIN Employee e2
    ON e1.managerId = e2.id
GROUP BY
    e2.id
HAVING
    COUNT(*) > 4

--------------------------------------------------------

SELECT name FROM Employee WHERE id IN 
(
    SELECT
        managerId
    FROM
        Employee
    GROUP BY
        managerId
    HAVING
        COUNT(distinct id) >= 5
)